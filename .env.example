# Local prototype. Never commit real keys or database files.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
FREE_CREDITS=3
# Set a model identifier available in your provider account; no obsolete default is assumed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Defaults to .data/credits.sqlite. Use a persistent private volume on a single host.
CREDIT_DATABASE=.data/credits.sqlite
# Payments are off by default. Only Stripe test keys are accepted in this release.
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_VALUE=
STRIPE_PRICE_PRO=
